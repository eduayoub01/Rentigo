@model Rentigo.Models.Voiture

@{
    ViewData["Title"] = "Modifier le Véhicule : " + Model.Marque + " " + Model.Modele;
}

<div class="container py-4" style="max-width: 720px;">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-warning text-dark py-3">
            <h4 class="card-title mb-0">✏️ Modifier le véhicule : @Model.Marque @Model.Modele (#@Model.Id)</h4>
        </div>
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Marque" class="form-label fw-bold"></label>
                        <input asp-for="Marque" class="form-control" />
                        <span asp-validation-for="Marque" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Modele" class="form-label fw-bold"></label>
                        <input asp-for="Modele" class="form-control" />
                        <span asp-validation-for="Modele" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Matricule" class="form-label fw-bold"></label>
                        <input asp-for="Matricule" class="form-control font-monospace" />
                        <span asp-validation-for="Matricule" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CategoryVoitureId" class="form-label fw-bold"></label>
                        <select asp-for="CategoryVoitureId" class="form-select" asp-items="ViewBag.Categories"></select>
                        <span asp-validation-for="CategoryVoitureId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Annee" class="form-label fw-bold"></label>
                        <input asp-for="Annee" type="number" class="form-control" />
                        <span asp-validation-for="Annee" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PrixJour" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <input asp-for="PrixJour" type="number" step="0.5" class="form-control" />
                            <span class="input-group-text">TND / jour</span>
                        </div>
                        <span asp-validation-for="PrixJour" class="text-danger small"></span>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch mt-2">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="EstDisponible" />
                            <label class="form-check-label fw-bold" asp-for="EstDisponible"></label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center pt-4 mt-3 border-top">
                    <a asp-action="Index" class="btn btn-outline-secondary">Retourner à la liste</a>
                    <button type="submit" class="btn btn-warning px-4">Mettre à jour le véhicule</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}